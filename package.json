{
  "name": "gooee",
  "version": "0.45.1",
  "description": "React components in black, white and grey with one blue accent. Copy them into your app with npx gooee add <name>.",
  "license": "MIT",
  "homepage": "https://gooee.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilmanhaikal/gooee-ui.git"
  },
  "type": "module",
  "bin": {
    "gooee": "scripts/add.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "scripts/add.js",
    "src/components",
    "src/internal",
    "src/tokens.css",
    "src/base.css",
    "scripts/pro-components.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "add": "node scripts/add.js",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}

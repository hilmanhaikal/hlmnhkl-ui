{
  "name": "gooee",
  "version": "1.1.0",
  "description": "React and Vue components in black, white and grey with one blue accent. Copy them into your app with npx gooee add <name>.",
  "license": "MIT",
  "homepage": "https://gooee.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilmanhaikal/gooee-ui.git"
  },
  "type": "module",
  "bin": {
    "gooee": "scripts/add.js"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "scripts/add.js",
    "src/components",
    "src/icons",
    "src/internal",
    "src/tokens.css",
    "src/base.css",
    "scripts/pro-components.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "add": "node scripts/add.js",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "@hookform/resolvers": "7.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "typescript": "^7.0.2",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  }
}
